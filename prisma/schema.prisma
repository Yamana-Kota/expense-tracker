// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Entry {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime
  type      String
  category  String
  amount    Int
  note      String?
  createdAt DateTime @default(now())

  @@index([userId])
}
